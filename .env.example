# Скопируйте в .env и заполните. Файл .env не публикуйте: в нём ключи доступа.

# GigaChat: «Ключ авторизации» из личного кабинета developers.sber.ru (Base64 от client_id:client_secret)
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Сертификаты GigaChat выпущены российским УЦ (НУЦ Минцифры): укажите путь к russian_trusted_root_ca.cer
# или, только для пробы, отключите проверку: GIGACHAT_VERIFY_SSL=false
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=true

# Запасной провайдер: OpenRouter (бесплатные модели с суффиксом :free). В промпт не попадают ФИО и контакты.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-235b-a22b:free

# Бот ВКонтакте: ключ доступа сообщества (Управление → Работа с API → Ключи доступа, право «Сообщения сообщества»)
VK_GROUP_TOKEN=
# Беседа кураторов, куда бот присылает карточки анкет: peer_id = 2000000000 + номер беседы
VK_CURATOR_PEER_ID=

# Быстрая модель GigaChat для уточнений прямо в диалоге (кандидат ждёт ответа). GigaChat-2 — это Lite.
GIGACHAT_FAST_MODEL=GigaChat-2

# Необязательно: сервисный ключ приложения ВК — открывает подписки и друзей кандидата для анализа страницы.
# vk.com/apps?act=manage → Создать приложение → Настройки → «Сервисный ключ доступа». Без ключа бот смотрит
# только профиль и членство в музейных сообществах из rubric.yaml (vk_analysis).
VK_SERVICE_TOKEN=

# Необязательно: через сколько дней после решения «Взят в команду» бот пришлёт опрос волонтёру.
# По умолчанию — из rubric.yaml (120 дней, около четырёх месяцев). 0 — сразу, для показа.
SURVEY_AFTER_DAYS=
